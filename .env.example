# Local Docker Postgres + MinIO (docker compose up -d). Real values live in .env (hook-protected, never committed).
DATABASE_URL=postgresql://coinfactory:coinfactory@localhost:5432/coinfactory

# Storage driver: minio (self-host, primary) | blob (Vercel preview)
STORAGE_DRIVER=
# S3/MinIO connection — required when STORAGE_DRIVER=minio; local compose exposes MinIO on localhost:9000 and creates the configured bucket.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# Vercel Blob token — required when STORAGE_DRIVER=blob
BLOB_READ_WRITE_TOKEN=

# Resend submission email (sender domain must be verified before production)
RESEND_API_KEY=
SUBMISSION_NOTIFICATION_EMAIL=
SUBMISSION_FROM_EMAIL=

# better-auth (admin-only panel; secret is 32+ chars)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
NEXT_PUBLIC_AUTH_URL=
# Seeded admin credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Sentry monitoring (public DSN may be exposed; auth token is build-only and secret)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
