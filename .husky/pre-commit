STAGED_FILES=$(git diff --name-only --cached)

# Filter to files biome can handle
BIOME_FILES=$(echo "$STAGED_FILES" | grep -E '\.(js|jsx|ts|tsx|json|jsonc|css)$' || true)

if [ -n "$STAGED_FILES" ]; then
  # Run format and lint only on staged files biome supports
  if [ -n "$BIOME_FILES" ]; then
    echo "$BIOME_FILES" | xargs pnpm biome check --write --no-errors-on-unmatched

    if ! git diff --quiet -- $(echo "$BIOME_FILES"); then
      echo "$BIOME_FILES" | xargs git add --
      echo ""
      echo "Lint fixes were applied and staged. Please review the changes and commit again."
      exit 1
    fi

    echo "$BIOME_FILES" | xargs pnpm biome check --no-errors-on-unmatched
  fi

  pnpm typecheck && pnpm react-doctor:staged
else
  # No staged files — run on all changes
  pnpm format

  if ! git diff --quiet; then
    git add -A
    echo ""
    echo "Lint fixes were applied and staged. Please review the changes and commit again."
    exit 1
  fi

  pnpm typecheck && pnpm lint && pnpm react-doctor
fi
